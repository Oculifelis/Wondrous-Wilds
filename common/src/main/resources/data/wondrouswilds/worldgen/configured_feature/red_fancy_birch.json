{
  "type": "minecraft:tree",
  "config": {
    "ignore_vines": true,
    "minimum_size": {
      "type": "minecraft:two_layers_feature_size",
      "limit": 1,
      "lower_size": 0,
      "upper_size": 2
    },
    "trunk_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "minecraft:birch_log"
      }
    },
    "trunk_placer": {
      "type": "wondrouswilds:straight_branching_trunk_placer",
      "base_height": 10,
      "height_rand_a": 10,
      "height_rand_b": 0,
      "min_branches": 0,
      "max_branches": 3,
      "min_branch_length": 1,
      "max_branch_length": 1
    },
    "foliage_provider": {
      "type": "minecraft:simple_state_provider",
      "state": {
        "Name": "wondrouswilds:red_birch_leaves"
      }
    },
    "foliage_placer": {
      "type": "wondrouswilds:fancy_birch_foliage_placer",
      "radius": 3,
      "offset": 0
    },
    "decorators": [
      {
        "type": "wondrouswilds:polypores"
      },
      {
        "type": "wondrouswilds:cobwebs"
      }
    ],
    "below_trunk_provider": {
      "type": "minecraft:rule_based_state_provider",
      "rules": [
        {
          "if_true": {
            "type": "minecraft:not",
            "predicate": {
              "type": "minecraft:matching_block_tag",
              "tag": "minecraft:cannot_replace_below_tree_trunk"
            }
          },
          "then": {
            "type": "minecraft:simple_state_provider",
            "state": {
              "Name": "minecraft:dirt"
            }
          }
        }
      ]
    }
  }
